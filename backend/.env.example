# ============================================================
# MediCore SaaS — Variables de entorno
# Copia este archivo como .env y configura tus valores
# ============================================================

# ── Servidor ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ── Base de datos (PostgreSQL recomendado) ────────────────
DB_TYPE=postgres          # postgres | mysql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medicore
DB_USER=medicore_user
DB_PASSWORD=TuPasswordSegura123!
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_SSL=false              # true en producción con certificado

# ── Redis (sesiones, cache, rate limiting) ────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=CambiaEstePorUnSecretoMuyLargo64Caracteres1234567890abcdefghijklmnop
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=OtroSecretoParaRefreshTokenMuySeguro64Chars1234567890abcdefghij
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://tu-dominio.com

# ── Almacenamiento de archivos (MinIO / S3-compatible) ───
STORAGE_TYPE=minio        # minio | s3 | local
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=medicore-docs
MINIO_USE_SSL=false

# Para S3:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_BUCKET=medicore-docs

# Para almacenamiento local:
UPLOAD_LOCAL_PATH=./uploads
UPLOAD_MAX_SIZE_MB=25

# ── Cifrado de documentos ────────────────────────────────
# Exactamente 32 caracteres (no agregar comentarios en esta linea)
ENCRYPTION_KEY=MediCoreSaaS2024EncryptionKey32!
ENCRYPTION_IV_LENGTH=16

# ── Email (Nodemailer) ───────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=noreply@tu-hospital.mx
MAIL_PASS=TuPasswordDeEmail
MAIL_FROM="MediCore SaaS <noreply@tu-hospital.mx>"

# ── SMS (Twilio — opcional) ──────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_FROM=

# ── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000   # 15 minutos
RATE_LIMIT_MAX=100            # peticiones por ventana
RATE_LIMIT_AUTH_MAX=10        # intentos de login por ventana

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=info                # error | warn | info | debug
LOG_FILE_PATH=./logs/medicore.log
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# ── Superadmin inicial ───────────────────────────────────
SUPERADMIN_EMAIL=superadmin@medicore.mx
SUPERADMIN_PASSWORD=CambiaEstePassword123!
SUPERADMIN_NAME=Superadministrador

# ── Demo / Seeds ─────────────────────────────────────────
SEED_DEMO_DATA=true           # false en producción real
DEMO_HOSPITAL_NAME=Hospital Demo MediCore
DEMO_HOSPITAL_SLUG=demo

# ── Configuración del SaaS ───────────────────────────────
SAAS_NAME=MediCore
SAAS_DOMAIN=medicore.mx
SAAS_SUPPORT_EMAIL=soporte@medicore.mx
